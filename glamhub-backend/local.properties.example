# Copy to local.properties (git-ignored) and fill in your own keys. Every key is optional.
app.aiornot.api-key=
app.sslcommerz.store-id=
app.sslcommerz.store-password=
app.sslcommerz.sandbox=true
app.gemini.api-key=
app.groq.api-key=
# Gmail app password + the Gmail address that owns it
spring.mail.password=
spring.mail.username=
app.mail-from=

# Cloudinary image storage (leave empty to keep storing uploads on local disk)
app.cloudinary.cloud-name=
app.cloudinary.api-key=
app.cloudinary.api-secret=
app.cloudinary.folder=Glamcloud
